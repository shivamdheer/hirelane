# hirelane reads these from the environment. None of them is a secret.
# API keys never belong in a file. Store them with `hirelane set-key`.

# Where config, data and resumes live. Default is ~/.hirelane
# HIRELANE_HOME=/path/to/hirelane-home

# Second switch for live submission. Live also needs submit_mode: live in config/settings.yaml.
# Leave unset to keep every run in review mode.
# HIRELANE_ALLOW_LIVE=1

# Only needed if Chromium was installed outside the default location.
# PLAYWRIGHT_BROWSERS_PATH=/path/to/browsers
